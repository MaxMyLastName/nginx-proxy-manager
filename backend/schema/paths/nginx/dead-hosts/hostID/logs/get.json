{
	"operationId": "getDeadHostLogs",
	"summary": "Get log preview for a 404 Host",
	"tags": ["404-hosts"],
	"security": [
		{
			"bearerAuth": ["dead_hosts.logs"]
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "hostID",
			"description": "The ID of the 404 Host",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 1
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"access": [
									"127.0.0.1 - - [30/Oct/2025:01:12:05 +0000] \"GET / HTTP/1.1\" 404 612"
								],
								"error": []
							}
						}
					},
					"schema": {
						"$ref": "../../../../../components/host-logs-object.json"
					}
				}
			}
		}
	}
}
